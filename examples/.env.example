# Address of the already-deployed URLReputationOracle contract.
ORACLE_CONTRACT_ADDRESS=0xYourDeployedContractAddressHere

# Network to use (shared by the TypeScript and Python examples):
# localnet | studionet | testnetAsimov | testnetBradbury   (genlayer-js, camelCase)
# localnet | studionet | testnet_asimov | testnet_bradbury (genlayer-py, snake_case)
#
# Note: the network name uses different casing conventions depending on
# the SDK (testnetAsimov vs testnet_asimov). "localnet" and "studionet"
# are the same in both. If you run examples in both languages on the same
# machine, use a separate .env per folder or export the correct value
# before each script.
GENLAYER_CHAIN=studionet
